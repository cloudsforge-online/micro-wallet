# Every variable this service reads, and nothing else.
#
# Rule 9 of docs/ecosystem/03 §2: a repository declares the variables it needs and the deploy
# provides exactly those. `env_file: .env` fan-out — which hands every container the whole estate's
# secrets — is banned, and this file is what makes the alternative possible: the deploy manifest is
# derived from it.
#
# Copy to `.env` for local work. `.env` is gitignored and must stay that way.

# --- required --------------------------------------------------------------------------------

# This service's own database. It reads no other, and CI fails on a second connection string.
WALLET_DATABASE_URL=postgres://wallet:wallet@127.0.0.1:5432/wallet

# Identity's JWKS and issuer. Token verification is the only thing this service asks identity for.
IDENTITY_JWKS_URL=http://127.0.0.1:4001/.well-known/jwks.json
IDENTITY_ISSUER=http://127.0.0.1:4001

# HMAC key for event signatures, outbound and inbound. At least 32 random characters:
#   openssl rand -base64 32
# Leaving a placeholder here is refused at boot, deliberately. Do not paste one back in.
#
# It is BOTH halves: outbound events are signed with it, and the `/events` intake verifies inbound
# ones with it. That means it is shared with the indexer, which is the producer this service
# subscribes to.
OUTBOX_SIGNING_SECRET=

# The four peers. This service owns no balances and no keys, so it cannot answer a single money
# question without the first of these.
LEDGER_URL=http://127.0.0.1:4004
CUSTODY_URL=http://127.0.0.1:4005
INDEXER_URL=http://127.0.0.1:4006
PRICING_URL=http://127.0.0.1:4007

# The token this service presents to all four. One token, not four: it is minted for
# `service:wallet` with the scopes wallet needs (ledger:post, ledger:read, ledger:reserve,
# custody:address, indexer:read, indexer:write, pricing:read) and each peer checks the one it
# cares about. Four tokens would be four rotations.
WALLET_SERVICE_TOKEN=

# The domain and URI an EIP-4361 challenge binds to. **Configuration, never a request field:** a
# signature collected by `wallet-cloudsforge.evil` names that domain in its message, and comparing
# against this value is what refuses it. Reading the expectation from the request would make the
# check tautological.
WALLET_CHALLENGE_DOMAIN=hub.cloudsforge.online
WALLET_CHALLENGE_URI=https://hub.cloudsforge.online/wallets/verify

# --- optional, with the defaults shown ---------------------------------------------------------

PORT=4000
NODE_ENV=development
LOG_LEVEL=info
WALLET_DATABASE_POOL_MAX=10

# The network this deployment settles on. **Never inferred from a request.** A stated network that
# is not this one is refused; an omitted one means this one. 04-domain-model §3.1, and
# 00-current-state §3.5 for what inference costs: on XRP the same seed produces the same address on
# both networks, so a record without a network binding describes two different pots of money.
# WALLET_NETWORK=testnet

# How long an EIP-4361 challenge is valid. Short deliberately: the nonce is single-use, so this
# bounds how long a stolen unsigned challenge is worth stealing.
# WALLET_CHALLENGE_TTL_SECONDS=600

# Absolute wall-clock ceiling on one outbound call, retries included.
# WALLET_UPSTREAM_DEADLINE_MS=8000

# Withdrawals can be paused without a deploy. A pause is a 503, never a silent queue.
# WALLET_WITHDRAWALS_ENABLED=true

# The smallest withdrawal, as a multiple of the quoted network fee. A withdrawal worth less than
# the fee to send it is a request to burn the user's money.
# WALLET_WITHDRAWAL_MIN_FEE_MULTIPLE=3

# How long a queued withdrawal may sit before it is `stuck` and an operator is told.
# WALLET_WITHDRAWAL_STUCK_MINUTES=60

# The operator-stated network fee per asset, in smallest units.
#
# **An interim.** It exists only until `micro-settlement` can quote a live fee, and it disappears
# with the one line in src/index.ts that reads it. An asset absent from it is refused with 503
# rather than priced by guessing — the same fail-closed rule as reconciliation tolerances.
# WALLET_FEE_QUOTES={"EMBER":"21000000000000"}

# How long an idempotency key is honoured. Expiring one EARLY means the next replay of it does the
# work a second time, so this must outlive every caller's retry horizon.
# WALLET_IDEMPOTENCY_TTL_DAYS=30

# Names this replica in jobs.locked_by. Defaults to the hostname, which is the container id under
# compose and the pod name under Kubernetes.
# INSTANCE_ID=

# The image tag, reported on every log line and in the release manifest.
# CLOUDSFORGE_TAG=dev

# --- not read by this service ------------------------------------------------------------------
#
# OTEL_EXPORTER_OTLP_ENDPOINT and the rest of OTEL_* are read by the OpenTelemetry SDK loaded ahead
# of the process (NODE_OPTIONS=--import @opentelemetry/auto-instrumentations-node/register), not by
# src/env.ts. They belong in the deploy, not here, because this service never reads them.
#
# WALLET_TEST_DATABASE_URL is read only by the test suite, and only when its name contains "test" —
# the database-backed tests truncate every table this service owns.
